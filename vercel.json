{
    "cleanUrls":  true,
    "trailingSlash":  false,
    "redirects":  [
                      {
                          "source":  "/produit-:nom",
                          "destination":  "/:nom",
                          "permanent":  true
                      },
                      {
                          "source":  "/shop/:chemin*",
                          "destination":  "/produits",
                          "permanent":  true
                      },
                      {
                          "source":  "/boutique/:chemin*",
                          "destination":  "/produits",
                          "permanent":  true
                      },
                      {
                          "source":  "/product/:chemin*",
                          "destination":  "/produits",
                          "permanent":  true
                      },
                      {
                          "source":  "/produit/:chemin*",
                          "destination":  "/produits",
                          "permanent":  true
                      },
                      {
                          "source":  "/product-category/:chemin*",
                          "destination":  "/produits",
                          "permanent":  true
                      },
                      {
                          "source":  "/categorie-produit/:chemin*",
                          "destination":  "/produits",
                          "permanent":  true
                      },
                      {
                          "source":  "/:page(cart|checkout|my-account|panier|commande|mon-compte)/:chemin*",
                          "destination":  "/",
                          "permanent":  true
                      }
                  ],
    "rewrites":  [
                     {
                         "source":  "/:page(electromenager|electronique|informatique|sacs|sport|jouets|divers|ozuko|neon|nexgen|roch|hisense|anlabeier|yaki|akai|haomax|perkins|baobab|samsung|zealot|cudy|tp-link|renz|elcon|tcl|sharp|idealpro|djack|jiepak|panmic|globalstar|cy|bose|onikuma|plokama|cat|sony|jbl|comfast|nc-link|baseus|xiaomi|borofone|ango-power|ldnio|baellerry|humerpaul|winning-star|refrigerateurs|congelateurs|machines-a-laver|cuisinieres|micro-ondes|ventilateurs|televiseurs|telephones|chargeurs|woofers|barres-de-son|casques|micros|supports-tv|rallonges|groupes-electrogenes|regulateurs|wifi|souris-claviers|sacs-a-dos|portefeuilles|pese-bagages|halteres|balances|rangement)",
                         "destination":  "/produits"
                     }
                 ],
    "headers":  [
                    {
                        "source":  "/(.*)",
                        "headers":  [
                                        {
                                            "key":  "Content-Security-Policy",
                                            "value":  "default-src \u0027self\u0027; script-src \u0027self\u0027 https://connect.facebook.net; style-src \u0027self\u0027 \u0027unsafe-inline\u0027 https://fonts.googleapis.com; font-src \u0027self\u0027 https://fonts.gstatic.com; img-src \u0027self\u0027 data: https://*.facebook.com https://*.fbcdn.net; connect-src \u0027self\u0027 https://*.facebook.com https://connect.facebook.net https://fonts.googleapis.com https://fonts.gstatic.com; frame-src https://www.facebook.com; frame-ancestors \u0027none\u0027; object-src \u0027none\u0027; base-uri \u0027self\u0027; form-action \u0027self\u0027 https://www.facebook.com; manifest-src \u0027self\u0027; worker-src \u0027self\u0027; upgrade-insecure-requests"
                                        },
                                        {
                                            "key":  "X-Content-Type-Options",
                                            "value":  "nosniff"
                                        },
                                        {
                                            "key":  "X-Frame-Options",
                                            "value":  "DENY"
                                        },
                                        {
                                            "key":  "Referrer-Policy",
                                            "value":  "strict-origin-when-cross-origin"
                                        },
                                        {
                                            "key":  "Permissions-Policy",
                                            "value":  "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
                                        },
                                        {
                                            "key":  "Cross-Origin-Opener-Policy",
                                            "value":  "same-origin"
                                        }
                                    ]
                    }
                ]
}
