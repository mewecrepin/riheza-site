{
    "cleanUrls":  true,
    "trailingSlash":  false,
    "redirects":  [
                      {
                          "source":  "/produit-:nom",
                          "destination":  "/:nom",
                          "permanent":  true
                      },
                      {
                          "source":  "/shop/:chemin*",
                          "destination":  "/produits",
                          "permanent":  true
                      },
                      {
                          "source":  "/boutique/:chemin*",
                          "destination":  "/produits",
                          "permanent":  true
                      },
                      {
                          "source":  "/product/:chemin*",
                          "destination":  "/produits",
                          "permanent":  true
                      },
                      {
                          "source":  "/produit/:chemin*",
                          "destination":  "/produits",
                          "permanent":  true
                      },
                      {
                          "source":  "/product-category/:chemin*",
                          "destination":  "/produits",
                          "permanent":  true
                      },
                      {
                          "source":  "/categorie-produit/:chemin*",
                          "destination":  "/produits",
                          "permanent":  true
                      },
                      {
                          "source":  "/:page(cart|checkout|my-account|panier|commande|mon-compte)/:chemin*",
                          "destination":  "/",
                          "permanent":  true
                      }
                  ],
    "rewrites":  [
                     {
                         "source":  "/:page(electromenager|electronique|informatique|sacs|sport|jouets|divers|ozuko|neon|nexgen|roch|hisense|anlabeier|yaki|akai|samsung|zealot|cudy|tp-link|elcon|tcl|sharp|idealpro|djack|jiepak|panmic|globalstar|cy|bose|onikuma|plokama|cat|sony|jbl|comfast|nc-link|baseus|xiaomi|borofone|ango-power|ldnio|baellerry|humerpaul|winning-star|refrigerateurs|congelateurs|machines-a-laver|cuisinieres|micro-ondes|ventilateurs|televiseurs|telephones|chargeurs|woofers|barres-de-son|casques|micros|supports-tv|rallonges|regulateurs|wifi|souris-claviers|sacs-a-dos|portefeuilles|pese-bagages|halteres|balances|rangement)",
                         "destination":  "/produits"
                     }
                 ]
}
